{
  "name": "elbformat/sulu-behat-bundle",
  "description": "Context and Helpers to integrate behat tests in your sulu application",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "sulu",
    "behat"
  ],
  "authors": [
    {
      "name": "Hannes Giesenow",
      "email": "hannes.giesenow@elbformat.de",
      "role": "Lead Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Elbformat\\SuluBehatBundle\\": "src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-dom": "*",
    "ext-json": "*",
    "behat/behat": "^3.8",
    "elbformat/symfony-behat-bundle": "^1.5",
    "friends-of-behat/symfony-extension": "^2.2",
    "sulu/sulu": "^3.0",
    "symfony/event-dispatcher": "^6.4|^7.1|^8.0"
  },
  "require-dev": {
    "dvdoug/behat-code-coverage": "^5.2",
    "friendsofphp/php-cs-fixer": "^3.3",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^9.5"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true,
      "composer/package-versions-deprecated": true,
      "php-http/discovery": false
    }
  }
}
